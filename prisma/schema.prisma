generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Document {
  id          String  @id @default(cuid())
  title       String
  description String?

  // Legacy free-text classification, predating the Grade→Subject→Lesson
  // taxonomy below. Kept (not removed) so existing documents created before
  // Step 6A keep rendering, and auto-populated from the taxonomy Subject's
  // name on new taxonomy-backed uploads so homepage/search grouping by this
  // field keeps working unchanged. The taxonomy relations below are the
  // source of truth going forward — see FEATURES.md Step 6A.
  subject      String
  academicYear String

  documentType DocumentType @default(OTHER)

  // Structured education taxonomy (Step 6A). All nullable so documents
  // created before this taxonomy existed remain valid; new uploads set all
  // three together (enforced in the upload service, not just the DB).
  gradeId    String?
  grade      Grade?   @relation(fields: [gradeId], references: [id], onDelete: SetNull)
  subjectId  String?
  subjectRef Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  lessonId   String?
  lesson     Lesson?  @relation(fields: [lessonId], references: [id], onDelete: SetNull)

  // File metadata — nullable so existing (fileless) documents keep working.
  fileKey      String?
  fileName     String?
  fileSize     Int?
  mimeType     String?
  fileCategory FileCategory?
  uploadedById String?
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ratings   DocumentRating[]
  comments  DocumentComment[]
  reports   DocumentReport[]
  bookmarks DocumentBookmark[]

  @@index([subject])
  @@index([documentType])
  @@index([academicYear])
  @@index([uploadedById])
  @@index([gradeId])
  @@index([subjectId])
  @@index([lessonId])
}

/**
 * One 1-5 star rating per User per Document (Step 7A). Aggregates
 * (average/count) are always computed on read, never cached on Document —
 * see `getRatingSummary()` in `src/lib/documents/rating.ts`. Deleting a
 * Document or User cascades to their ratings so none are left orphaned.
 */
model DocumentRating {
  id String @id @default(cuid())

  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  /** 1-5, enforced at the application layer (zod) — see src/lib/validation/rating.ts. */
  value Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([documentId, userId])
  @@index([documentId])
  @@index([userId])
}

/**
 * A single, flat (non-threaded) comment on a Document — Step 7B. Content
 * length is capped at the application layer only (see
 * `COMMENT_MAX_LENGTH` in `src/lib/documents/comment-config.ts`), matching
 * how `DocumentRating.value`'s 1-5 range is enforced above. Deleting a
 * Document or User cascades to their comments so none are left orphaned.
 */
model DocumentComment {
  id String @id @default(cuid())

  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  content String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([documentId])
  @@index([userId])
}

/**
 * A user's personal bookmark/favorite on a Document — Step 8A. Purely
 * private to each user (no global bookmark count, no popularity ranking).
 * `@@unique([documentId, userId])` guarantees one bookmark per user per
 * document; adding is implemented as an idempotent `upsert` on this key
 * rather than relying on catching a constraint violation. Deleting a
 * Document or User cascades to their bookmarks so none are left orphaned.
 */
model DocumentBookmark {
  id String @id @default(cuid())

  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([documentId, userId])
  @@index([documentId])
  @@index([userId])
}

/**
 * A user-submitted report flagging a problem with a Document — Step 7C.
 * Only ever created as OPEN here; resolving/dismissing is a future Admin
 * moderation step. A partial unique index — added by hand in this model's
 * migration, since Prisma's schema DSL can't express a `WHERE` clause on
 * `@@unique` — enforces at most one OPEN report per
 * (documentId, userId, reason) at the database level; the API also
 * pre-checks this for a friendly 409 rather than relying on the raw
 * constraint violation alone. Deleting a Document or User cascades to
 * their reports so none are left orphaned.
 */
model DocumentReport {
  id String @id @default(cuid())

  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  reason ReportReason
  /** Optional except when reason is OTHER — enforced at the application layer (zod), see src/lib/validation/report.ts. */
  description String?
  status      ReportStatus @default(OPEN)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([documentId])
  @@index([userId])
  @@index([status])
}

enum ReportReason {
  BROKEN_FILE
  WRONG_CONTENT
  WRONG_TAXONOMY
  PREVIEW_ISSUE
  DUPLICATE_DOCUMENT
  COPYRIGHT
  OTHER
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

enum Role {
  STUDENT
  TEACHER
  ADMIN
}

enum FileCategory {
  PDF
  WORD
  EXCEL
  IMAGE
  VIDEO
}

/** Controlled classification for what a Document actually is — replaces free-text documentType. */
enum DocumentType {
  LECTURE
  EXERCISE
  EXAM
  ANSWER
  REFERENCE
  OTHER
}

/** School grade/class level — the root of the education taxonomy. */
model Grade {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subjects  Subject[]
  documents Document[]

  @@index([sortOrder])
}

/** A Subject belongs to exactly one Grade for this MVP (no many-to-many yet). */
model Subject {
  id      String @id @default(cuid())
  name    String
  code    String
  gradeId String
  grade   Grade  @relation(fields: [gradeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lessons   Lesson[]
  documents Document[]

  @@unique([gradeId, code])
  @@index([gradeId])
}

/** A Lesson/Topic belongs to exactly one Subject. */
model Lesson {
  id        String  @id @default(cuid())
  name      String
  code      String
  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents Document[]

  @@unique([subjectId, code])
  @@index([subjectId])
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(STUDENT)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  uploadedDocuments Document[]
  ratings           DocumentRating[]
  comments          DocumentComment[]
  reports           DocumentReport[]
  bookmarks         DocumentBookmark[]

  @@index([role])
}
