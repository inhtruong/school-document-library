generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Document {
  id          String  @id @default(cuid())
  title       String
  description String?

  // Legacy free-text classification, predating the Grade→Subject→Lesson
  // taxonomy below. Kept (not removed) so existing documents created before
  // Step 6A keep rendering, and auto-populated from the taxonomy Subject's
  // name on new taxonomy-backed uploads so homepage/search grouping by this
  // field keeps working unchanged. The taxonomy relations below are the
  // source of truth going forward — see FEATURES.md Step 6A.
  subject      String
  academicYear String

  documentType DocumentType @default(OTHER)

  // Structured education taxonomy (Step 6A). All nullable so documents
  // created before this taxonomy existed remain valid; new uploads set all
  // three together (enforced in the upload service, not just the DB).
  gradeId    String?
  grade      Grade?   @relation(fields: [gradeId], references: [id], onDelete: SetNull)
  subjectId  String?
  subjectRef Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  lessonId   String?
  lesson     Lesson?  @relation(fields: [lessonId], references: [id], onDelete: SetNull)

  // File metadata — nullable so existing (fileless) documents keep working.
  fileKey      String?
  fileName     String?
  fileSize     Int?
  mimeType     String?
  fileCategory FileCategory?
  uploadedById String?
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  // Moderation foundation (FEAT-10A). `@default(APPROVED)` is deliberate:
  // it backfills every pre-existing row to APPROVED as part of this
  // additive migration (existing documents were already public), and acts
  // as a safe fallback for any direct `create()` that forgets to set it
  // explicitly. It is NOT the business rule for new uploads — the upload
  // service always sets this field explicitly per uploader role
  // (TEACHER -> PENDING, ADMIN -> APPROVED), never relying on this default.
  moderationStatus DocumentModerationStatus @default(APPROVED)
  reviewedAt       DateTime?
  reviewedById     String?
  // Named relation ("DocumentReviewer") to avoid colliding with the
  // uploadedBy relation above — both point at User. SetNull so a deleted
  // reviewer account never cascades into deleting the Document itself.
  reviewedBy       User?                    @relation("DocumentReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  rejectionReason  String?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ratings       DocumentRating[]
  comments      DocumentComment[]
  reports       DocumentReport[]
  bookmarks     DocumentBookmark[]
  notifications Notification[]

  @@index([subject])
  @@index([documentType])
  @@index([academicYear])
  @@index([uploadedById])
  @@index([gradeId])
  @@index([subjectId])
  @@index([lessonId])
  @@index([reviewedById])
  // Almost every public document query filters `moderationStatus:
  // APPROVED`; the default sort (and the homepage's "latest documents")
  // also orders by `createdAt desc`, so this compound index directly
  // serves that exact combination rather than adding a second,
  // less-justified standalone index on moderationStatus alone.
  @@index([moderationStatus, createdAt])
  // GIN/trigram indexes backing the `ILIKE '%term%'` search in
  // src/app/api/documents/route.ts — without these, that query is a full
  // sequential scan (confirmed via EXPLAIN) that gets linearly slower as
  // the Document table grows. Requires the `pg_trgm` extension, enabled in
  // this model's migration.
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "Document_title_trgm_idx")
  @@index([description(ops: raw("gin_trgm_ops"))], type: Gin, map: "Document_description_trgm_idx")
  @@index([subject(ops: raw("gin_trgm_ops"))], type: Gin, map: "Document_subject_trgm_idx")
}

/**
 * One 1-5 star rating per User per Document (Step 7A). Aggregates
 * (average/count) are always computed on read, never cached on Document —
 * see `getRatingSummary()` in `src/lib/documents/rating.ts`. Deleting a
 * Document or User cascades to their ratings so none are left orphaned.
 */
model DocumentRating {
  id String @id @default(cuid())

  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  /** 1-5, enforced at the application layer (zod) — see src/lib/validation/rating.ts. */
  value Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([documentId, userId])
  @@index([documentId])
  @@index([userId])
}

/**
 * A single, flat (non-threaded) comment on a Document — Step 7B. Content
 * length is capped at the application layer only (see
 * `COMMENT_MAX_LENGTH` in `src/lib/documents/comment-config.ts`), matching
 * how `DocumentRating.value`'s 1-5 range is enforced above. Deleting a
 * Document or User cascades to their comments so none are left orphaned.
 */
model DocumentComment {
  id String @id @default(cuid())

  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  content String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([documentId])
  @@index([userId])
}

/**
 * A user's personal bookmark/favorite on a Document — Step 8A. Purely
 * private to each user (no global bookmark count, no popularity ranking).
 * `@@unique([documentId, userId])` guarantees one bookmark per user per
 * document; adding is implemented as an idempotent `upsert` on this key
 * rather than relying on catching a constraint violation. Deleting a
 * Document or User cascades to their bookmarks so none are left orphaned.
 */
model DocumentBookmark {
  id String @id @default(cuid())

  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([documentId, userId])
  @@index([documentId])
  @@index([userId])
}

/**
 * A user-submitted report flagging a problem with a Document — Step 7C.
 * Only ever created as OPEN here; resolving/dismissing is a future Admin
 * moderation step. A partial unique index — added by hand in this model's
 * migration, since Prisma's schema DSL can't express a `WHERE` clause on
 * `@@unique` — enforces at most one OPEN report per
 * (documentId, userId, reason) at the database level; the API also
 * pre-checks this for a friendly 409 rather than relying on the raw
 * constraint violation alone. Deleting a Document or User cascades to
 * their reports so none are left orphaned.
 */
model DocumentReport {
  id String @id @default(cuid())

  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  reason ReportReason
  /** Optional except when reason is OTHER — enforced at the application layer (zod), see src/lib/validation/report.ts. */
  description String?
  status      ReportStatus @default(OPEN)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([documentId])
  @@index([userId])
  @@index([status])
}

enum ReportReason {
  BROKEN_FILE
  WRONG_CONTENT
  WRONG_TAXONOMY
  PREVIEW_ISSUE
  DUPLICATE_DOCUMENT
  COPYRIGHT
  OTHER
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

enum Role {
  STUDENT
  TEACHER
  ADMIN
}

/** FEAT-10A moderation foundation. Deliberately only these 3 states — see schema comment on Document.moderationStatus. */
enum DocumentModerationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum FileCategory {
  PDF
  WORD
  EXCEL
  IMAGE
  VIDEO
}

/** Controlled classification for what a Document actually is — replaces free-text documentType. */
enum DocumentType {
  LECTURE
  EXERCISE
  EXAM
  ANSWER
  REFERENCE
  OTHER
}

/** School grade/class level — the root of the education taxonomy. */
model Grade {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subjects  Subject[]
  documents Document[]

  @@index([sortOrder])
}

/** A Subject belongs to exactly one Grade for this MVP (no many-to-many yet). */
model Subject {
  id      String @id @default(cuid())
  name    String
  code    String
  gradeId String
  grade   Grade  @relation(fields: [gradeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lessons   Lesson[]
  documents Document[]

  @@unique([gradeId, code])
  @@index([gradeId])
  /// GIN/trigram index backing the `subjectRef.name` ILIKE search — see Document's title/description/subject indexes above.
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "Subject_name_trgm_idx")
}

/** A Lesson/Topic belongs to exactly one Subject. */
model Lesson {
  id        String  @id @default(cuid())
  name      String
  code      String
  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents Document[]
  follows   LessonFollow[]

  @@unique([subjectId, code])
  @@index([subjectId])
  /// GIN/trigram index backing the `lesson.name` ILIKE search — see Document's title/description/subject indexes above.
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "Lesson_name_trgm_idx")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(STUDENT)
  /// CORE-1: incremented on password change to invalidate every JWT issued
  /// before it (see src/lib/auth/session.ts) — never exposed to the client.
  sessionVersion Int    @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  uploadedDocuments Document[]
  reviewedDocuments Document[] @relation("DocumentReviewer")
  ratings           DocumentRating[]
  comments          DocumentComment[]
  reports           DocumentReport[]
  bookmarks         DocumentBookmark[]
  teacherFollowing  TeacherFollow[] @relation("TeacherFollowFollower")
  followedByUsers   TeacherFollow[] @relation("TeacherFollowTeacher")
  lessonFollows     LessonFollow[]
  notifications     Notification[]

  @@index([role])
}

/**
 * A user following a TEACHER user — Step 8B. Only a `role = TEACHER` User
 * may be the `teacher` side (enforced at the application layer, see
 * `src/lib/follow/teacher-follow.ts`; Prisma can't express a role
 * constraint on a relation). Two distinct relations to `User` (follower
 * and teacher) require named relations. Self-follow (`followerId ==
 * teacherId`) is rejected at the application layer, not the schema.
 * `@@unique([followerId, teacherId])` guarantees one follow per pair;
 * deleting either User cascades to the follow row.
 */
model TeacherFollow {
  id String @id @default(cuid())

  followerId String
  follower   User   @relation("TeacherFollowFollower", fields: [followerId], references: [id], onDelete: Cascade)
  teacherId  String
  teacher    User   @relation("TeacherFollowTeacher", fields: [teacherId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([followerId, teacherId])
  @@index([followerId])
  @@index([teacherId])
}

/**
 * A user following a Lesson/Topic — Step 8B. No follower counts are
 * denormalized anywhere; Step 8C will later query this table directly to
 * find who to notify about a new Document in a followed Lesson.
 * `@@unique([userId, lessonId])` guarantees one follow per pair; deleting
 * the User or Lesson cascades to the follow row.
 */
model LessonFollow {
  id String @id @default(cuid())

  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId String
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, lessonId])
  @@index([userId])
  @@index([lessonId])
}

/**
 * An in-app notification for a User — Step 8C. Currently only generated
 * for `NEW_DOCUMENT` (a followed Teacher or followed Lesson got a new
 * upload); the enum stays small on purpose rather than pre-designing
 * categories (comment/rating/report) that don't exist yet. Title/message
 * are always server-generated plain text — never HTML, never
 * client-supplied. `readAt = null` means unread. `@@unique([userId,
 * documentId, type])` makes generation idempotent: a user who follows both
 * the Document's Teacher and its Lesson gets only one row per Document,
 * and `createMany({ skipDuplicates: true })` can be called safely more
 * than once. Deleting the User or the Document cascades — a notification
 * never outlives what it's about.
 */
model Notification {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  type    NotificationType
  title   String
  message String

  createdAt DateTime  @default(now())
  readAt    DateTime?

  @@unique([userId, documentId, type])
  // Compound, not just `@@index([userId])` — every read (listNotifications,
  // getUnreadNotificationCount, markAllNotificationsRead) filters by
  // `{userId, readAt: null}` or `{userId}` alone; the compound index serves
  // both via the leftmost-prefix rule, so the plain userId index would be
  // redundant. Without this, an unread-count scoped to one user still has
  // to filter `readAt` row-by-row across that user's whole notification
  // history instead of jumping straight to the unread ones.
  @@index([userId, readAt])
  @@index([documentId])
}

/** Kept intentionally small — see Notification's doc comment. */
enum NotificationType {
  NEW_DOCUMENT
}
