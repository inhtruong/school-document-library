DATABASE_URL="postgresql://postgres:postgres@localhost:5432/school_library?schema=public"

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="replace-with-a-generated-secret"

# Required when running `npm start` (production mode) on any host other than
# Vercel — Auth.js v5 otherwise rejects the request with "UntrustedHost".
# Not needed for `npm run dev`. See https://errors.authjs.dev#untrustedhost
AUTH_TRUST_HOST="true"

# Uploaded files are stored locally under storage_local/ (auto-created) in
# development — no external storage credentials are required.

# --- Production-only (Step 13A) ---
# The variables below are read by src/lib/env-core.ts (re-exported, guarded,
# from src/lib/env.ts for real app code). They're optional in development
# (sensible defaults apply) but validated at startup — see
# validateProductionEnv() in next.config.ts — when NODE_ENV=production.
# In production, npm start binds to 127.0.0.1:3000 only (see README's
# Production section) — Nginx (a later step) proxies to that address.

# Absolute path for persistent upload storage, kept OUTSIDE the release/
# source directory so a new deploy can never delete uploaded files (see
# README's Uploads section). Required when NODE_ENV=production — a relative
# path is rejected too, not just a missing one.
# Example VPS layout: source at /var/www/school-library/current, storage at
# /var/lib/school-library/storage.
# STORAGE_ROOT="/var/lib/school-library/storage"

# Upload size ceiling in MB — optional; unset defaults to 10. If set, it
# must be a positive number — 0, a negative value, or non-numeric text all
# fail validateProductionEnv() with a clear error rather than silently
# falling back to 10. Consumed at two different times: an app restart picks
# up a new value for validation (src/lib/documents/upload-config.ts), but
# next.config.ts's Server Action body-size ceiling is baked in at `next
# build` time — a raised limit only takes effect there after a full
# rebuild. Use the SAME value at build time and at start time.
# MAX_UPLOAD_SIZE_MB="10"

# The app's public base URL (e.g. what Nginx's server_name/proxy_pass
# should point at). Optional — not required even in production, and not
# currently read by any request path (reserved for ops documentation and
# any future absolute-URL need). If set, it must be a valid http:// or
# https:// URL; production should normally use https://.
# APP_URL="https://library.example.com"
